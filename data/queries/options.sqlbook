-- SQLBook: Code
SELECT      count(*) 'check',
            contract_code,
            DATE(ts_event) ts_event, 
            contract_delivery_period, 
            sum(close) close
FROM        (
                SELECT      ohlc.*, ohlc.close * (ohlc.volume / day_total.volume) as wavg_price
                FROM        (
                                SELECT  *
                                FROM    ice_futures_data_month 
                                WHERE   close is not NULL
                            ) ohlc
                                INNER JOIN
                            (
                                SELECT      symbol, sum(volume) volume
                                FROM        ice_futures_data_month 
                                WHERE       close is not NULL
                                GROUP BY    symbol
                            ) day_total
                            ON ohlc.symbol = day_total.symbol
                
            ) 
GROUP BY    contract_code,
            ts_event, 
            contract_delivery_period
ORDER BY    contract_code,
            ts_event, 
            contract_delivery_period
