-- SQLBook: Code
-- 
-- CHECK IF DOUBLE EXPIRY DATE FOR ONE DELIVERY PERIOD 
-- 
SELECT      contract_delivery_period, max( option_expiry_date), count(*) 
FROM        ( SELECT     DISTINCT contract_delivery_period, option_expiry_date 
FROM        ice_options_data_month)
GROUP BY    contract_delivery_period
HAVING      count (*) >1
-- SQLBook: Code
-- 
-- CHECK MISSING DELIVERY PERIOD
-- 
SELECT      * 
FROM        ice_options_data_qsy_truncation_issue 
WHERE       contract_delivery_period_from not in (
                                                    SELECT      contract_delivery_period 
                                                    FROM        ( 
                                                                    SELECT     DISTINCT contract_delivery_period, option_expiry_date 
                                                                    FROM        ice_options_data_month
                                                                )
                                                    GROUP BY    contract_delivery_period
                                                )
ORDER BY contract_delivery_period_from
